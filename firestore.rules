rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'pending'); }
    function hotel() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('hotelId', null); }
    function superAdmin() { return signedIn() && role() == 'super_admin'; }
    function hotelAdmin(hotelId) { return signedIn() && role() == 'hotel_admin' && hotel() == hotelId; }
    function hotelStaff(hotelId) { return signedIn() && role() in ['hotel_admin', 'staff'] && hotel() == hotelId; }
    function own() { return request.resource.data.get('userId', null) == request.auth.uid; }
    function fieldsOk() { return request.resource.data.size() <= 50; }
    function roomStatusOk() { return !('status' in request.resource.data) || request.resource.data.status in ['Available','Occupied','Cleaning','Maintenance','Out of Service']; }
    function bookingStatusOk() { return !('status' in request.resource.data) || request.resource.data.status in ['Confirmed','Checked In','Checked Out','Cancelled','No Show']; }
    function orderStatusOk() { return !('status' in request.resource.data) || request.resource.data.status in ['Open','Served','Paid','Cancelled']; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || superAdmin() || (role() == 'hotel_admin' && resource.data.get('hotelId', null) == hotel()));
      allow create: if signedIn() && ((superAdmin() && ((request.resource.data.role == 'hotel_admin' && request.resource.data.hotelId is string && exists(/databases/$(database)/documents/hotels/$(request.resource.data.hotelId))) || (request.resource.data.role == 'super_admin' && request.resource.data.hotelId == null))) || (role() == 'hotel_admin' && request.resource.data.role == 'staff' && request.resource.data.hotelId == hotel()));
      allow update: if signedIn() && (superAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.hotelId == resource.data.hotelId) || (role() == 'hotel_admin' && resource.data.role == 'staff' && resource.data.hotelId == hotel() && request.resource.data.role == 'staff' && request.resource.data.hotelId == hotel()));
      allow delete: if superAdmin() || (role() == 'hotel_admin' && resource.data.role == 'staff' && resource.data.hotelId == hotel());
    }

    match /hotels/{hotelId} {
      allow read: if signedIn() && (superAdmin() || hotel() == hotelId);
      allow create, update: if superAdmin();
      allow delete: if false;

      match /rooms/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk() && roomStatusOk();
        allow update: if hotelStaff(hotelId) && fieldsOk() && roomStatusOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /accomodation/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk() && bookingStatusOk();
        allow update: if hotelStaff(hotelId) && fieldsOk() && bookingStatusOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /reservations/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk() && bookingStatusOk();
        allow update: if hotelStaff(hotelId) && fieldsOk() && bookingStatusOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /folioItems/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update: if hotelStaff(hotelId) && fieldsOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /payments/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update: if hotelStaff(hotelId) && fieldsOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /housekeepingTasks/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update: if hotelStaff(hotelId) && fieldsOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /maintenanceRequests/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update: if hotelStaff(hotelId) && fieldsOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /nightAudits/{docId} {
        allow read: if hotelAdmin(hotelId);
        allow create: if hotelAdmin(hotelId) && own() && fieldsOk();
        allow update: if false;
        allow delete: if false;
      }
      match /restaurant/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk() && orderStatusOk();
        allow update: if hotelStaff(hotelId) && fieldsOk() && orderStatusOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /conferenceRooms/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update: if hotelStaff(hotelId) && fieldsOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /conferenceSpaces/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update: if hotelStaff(hotelId) && fieldsOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /expenses/{docId} {
        allow read: if hotelStaff(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update: if hotelStaff(hotelId) && fieldsOk();
        allow delete: if hotelAdmin(hotelId);
      }
      match /auditLog/{docId} {
        allow read: if hotelAdmin(hotelId);
        allow create: if hotelStaff(hotelId) && own() && fieldsOk();
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
