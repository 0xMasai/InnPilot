rules_version = '2';

// Role model (stored on users/{uid}.role):
//   "admin"   — full access, manages users and can delete records
//   "staff"   — day-to-day operations: read/create/update operational data
//   "pending" — newly signed-up account awaiting admin approval; no data access
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role of the requesting user ("pending" if the doc or field is missing).
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('role', 'pending');
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isStaff() {
      return isSignedIn() && myRole() in ['admin', 'staff'];
    }

    // ---------- Users ----------
    match /users/{userId} {
      // Users may read their own profile; admins may read anyone's.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // A user may create only their own doc, and only as "pending".
      // (Admins may create user docs with any role.)
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.get('role', 'pending') == 'pending')
      );

      // Users may update their own profile but never their own role.
      // Only admins may change roles (approve accounts, promote, demote).
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.get('role', 'pending') == resource.data.get('role', 'pending'))
      );

      allow delete: if isAdmin();
    }

    // ---------- Operational data ----------
    // Staff and admins can read and write; only admins can delete.
    // Note: "accomodation" spelling matches existing documents.
    match /rooms/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /accomodation/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /restaurant/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /conferenceRooms/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Conference room inventory (the physical spaces; bookings live in
    // "conferenceRooms" above for legacy reasons).
    match /conferenceSpaces/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /expenses/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- Audit log ----------
    // Append-only: staff may write entries about their own actions;
    // only admins may read; nothing is ever edited or deleted.
    match /auditLog/{docId} {
      allow read: if isAdmin();
      allow create: if isStaff() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
