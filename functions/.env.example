# InnPilot AI Agent — gateway configuration (server-side only).
#
# These belong to whatever host runs the AI gateway, not to the browser
# app. Copy to functions/.env for local runs; in a deployed environment set
# them in the host's environment/secret store.
#
# None of these use the VITE_ prefix on purpose: this repo's VITE_* values
# (firebase.ts) are bundled into public browser JS, which is the wrong
# place for anything on this list — especially the two credentials.

# --- AI provider -----------------------------------------------------------

# Which provider implementation to construct. Supported: openai, anthropic
AI_PROVIDER=openai

# Model id for that provider. Optional — omit for the provider default
# (openai: gpt-5.6). Cheaper drop-ins: gpt-5.6-terra, gpt-5.6-luna.
AI_MODEL=

# Optional response token cap (positive integer). Default: 4096
AI_MAX_TOKENS=

# Optional reasoning effort: low | medium | high. Default: medium
AI_EFFORT=

# The provider API key. Never commit a value here — set it in the host's
# secret store (or in functions/.env, which is git-ignored, for local runs).
# AI_API_KEY=

# --- Firebase Admin credentials --------------------------------------------

# The service-account JSON for hotel-management-c183c, as a single-line
# value (raw JSON or base64 of it). Required when the gateway runs anywhere
# other than Google infrastructure, since there is no metadata server to
# fall back on. Omit it to use Application Default Credentials instead
# (GOOGLE_APPLICATION_CREDENTIALS, or the ambient service account).
#
# This key bypasses every rule in firestore.rules. Secret store only.
# FIREBASE_SERVICE_ACCOUNT=
