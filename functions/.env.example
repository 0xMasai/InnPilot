# InnPilot AI Agent — Cloud Functions configuration.
#
# Copy to functions/.env for local/emulator runs; firebase-functions loads
# functions/.env (and functions/.env.<project-id>) automatically at deploy.
# functions/.env is git-ignored — never commit real values.
#
# NOTE: none of these use the VITE_ prefix, and they must not. VITE_* values
# (see the root firebase.ts) are bundled into public client JS; these are
# server-side only.

# Which provider implementation to use. Unset = the assistant is not
# connected, and it says so instead of answering. Supported: anthropic
AI_PROVIDER=anthropic

# Provider model id. Optional — defaults to claude-opus-5 for anthropic.
AI_MODEL=claude-opus-5

# Optional limits. Defaults: 4096 tokens, 50000 ms, 1 retry.
# AI_TIMEOUT_MS x (AI_MAX_RETRIES + 1) must stay below the aiChat callable's
# timeoutSeconds (120), or a slow provider becomes a function timeout.
# AI_MAX_TOKENS=4096
# AI_TIMEOUT_MS=50000
# AI_MAX_RETRIES=1

# Optional reasoning effort: low | medium | high | xhigh | max.
# Unset = the provider's own default.
# AI_EFFORT=high

# The API key is NOT set here — it is a Cloud Functions secret, stored in
# Google Secret Manager and bound to the aiChat function:
#
#   firebase functions:secrets:set AI_API_KEY
#
# For the functions emulator only, a local functions/.env may define
# AI_API_KEY=... — that file is git-ignored and must never hold a
# production key.
