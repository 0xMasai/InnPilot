# InnPilot AI Agent — Cloud Functions configuration (server-side only).
#
# Copy to functions/.env and fill in for local emulator runs. Deployed
# values for the non-secret keys come from functions/.env (Firebase loads
# it at deploy); AI_API_KEY is a Cloud Functions secret and must NEVER be
# put in this file or in .env.
#
# None of these use the VITE_ prefix on purpose: this repo's VITE_* values
# (firebase.ts) are bundled into public browser JS, which is the wrong
# place for anything on this list — especially the API key.

# Which provider implementation to construct. Supported: anthropic
AI_PROVIDER=anthropic

# Model id for that provider. Optional — omit to use the provider default.
AI_MODEL=

# Optional response token cap (positive integer). Default: 4096
AI_MAX_TOKENS=

# Optional reasoning effort: low | medium | high. Default: medium
AI_EFFORT=

# The provider API key. Do NOT set it here or in functions/.env — it is a
# secret bound to the aiChat function:
#   firebase functions:secrets:set AI_API_KEY
# For the local emulator only, an AI_API_KEY in functions/.env.local works
# (that file is git-ignored).
# AI_API_KEY=
