# InnPilot environment.
#
# Copy to .env for local development (.env is git-ignored). Values for the
# deployed app go in the Vercel project's Environment Variables, not here.
#
# The VITE_ prefix is the dividing line: Vite bundles VITE_* into the
# public browser JS, so anything with that prefix is world-readable. The
# AI and Admin credentials below must never get one.

# --- Frontend (public — bundled into the browser) --------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Where Ask InnPilot sends questions. Unset means same-origin /api/ai-chat,
# which is correct in production — the Vercel function deploys alongside the
# app. `vite dev` does NOT run anything in api/, so a local UI can only reach
# the agent by pointing this at a deployment (or a `vercel dev` server). The
# request is then cross-origin, so that origin must also be listed in the
# gateway's ALLOWED_ORIGINS below.
# VITE_AI_API_BASE=https://hotel-ms-six.vercel.app

# --- AI gateway (server-side only — api/ai-chat.ts) ------------------------

# Which provider implementation to construct. Supported: openai
AI_PROVIDER=openai

# Model id for that provider. Optional — omit for the provider default
# (gpt-5.6). Cheaper drop-ins: gpt-5.6-terra, gpt-5.6-luna.
AI_MODEL=

# Optional response token cap (positive integer). Default: 4096
AI_MAX_TOKENS=

# Optional reasoning effort: low | medium | high. Default: medium
AI_EFFORT=

# The provider API key. Never commit a value.
# AI_API_KEY=

# How much the gateway logs, as one JSON object per line, to the host's
# log stream: debug | info | warn | error | silent. Default: info, which
# is one line per request, per model round-trip, per tool call and per
# confirmation step. Drop to `error` to keep only failures.
#
# Log lines carry ids, enums, counts and durations — never the user's
# question, tool arguments, tool results or guest names. See
# server/ai/logger.ts.
# AI_LOG_LEVEL=info

# --- Firebase Admin (server-side only) -------------------------------------

# The service-account JSON as a single-line value (raw JSON or base64).
# This is how the deployed function authenticates: Vercel has no Google
# metadata server to fall back on.
#
# This key bypasses every rule in firestore.rules. Secret store only.
# FIREBASE_SERVICE_ACCOUNT=

# Locally you can point at a key file instead, which the Admin SDK reads
# via Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# --- CORS ------------------------------------------------------------------

# Only needed when the app is served from a different origin than the API.
# Comma-separated exact origins; unset means same-origin only.
# ALLOWED_ORIGINS=https://innpilot.example.com
